# Live (non-secret) config for the "api" Cloud Function - Firebase loads this
# automatically on `firebase deploy` to project bocofac-ad6b4. Secrets
# (DB_PASS, JWT_SECRET, BREVO_API_KEY) are NOT here: they're stored with
# `firebase functions:secrets:set <NAME>` and injected at runtime.
INSTANCE_CONNECTION_NAME=bocofac-ad6b4:asia-southeast1:bocofac-db
DB_USER=postgres
DB_NAME=bocofac
FRONTEND_ORIGIN=https://bocofac-ad6b4.web.app,https://bocofac-ad6b4.firebaseapp.com
COOKIE_SECURE=true
SMTP_FROM=bocofac.admin@gmail.com
# A function's disk is wiped whenever it restarts, so /tmp/uploads is only a
# cache: every upload is also copied to this Firebase Storage bucket and read
# back from there when the cached copy is gone.
UPLOADS_DIR=/tmp/uploads
STORAGE_BUCKET=bocofac-ad6b4.firebasestorage.app

# Printed on PMES certificates. Update after a board election.
CHAIRPERSON_NAME=Minerva A. Longaza
