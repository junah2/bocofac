DATABASE_URL=postgresql://postgres:devpass@localhost:5432/bocofac
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000
# Comma-separated list of origins allowed to make credentialed (cookie)
# requests - add a LAN IP or tunneled dev URL here if you need to reach the
# frontend from somewhere other than plain localhost.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

SEED_ADMIN_EMAIL=admin@bocofac.coop
SEED_ADMIN_PASSWORD=Admin123!
SEED_BOARD_EMAIL=board@bocofac.coop
SEED_BOARD_PASSWORD=Board123!

# Gmail SMTP for password-reset emails - use a Gmail App Password, not your
# normal login password (Google Account > Security > 2-Step Verification > App Passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
