DATABASE_URL=postgresql://postgres:devpass@localhost:5432/bocofac
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000
# Comma-separated list of origins allowed to make credentialed (cookie)
# requests - add a LAN IP or tunneled dev URL here if you need to reach the
# frontend from somewhere other than plain localhost.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false

# Where uploaded files (product photos, avatars, applicant documents, order
# receipts) get written. Leave unset for local dev - defaults to ./uploads
# next to the repo. In production on a host with an ephemeral filesystem
# (Cloud Run, Cloud Functions, most containers), point this at a mounted
# persistent volume/bucket instead, or uploads will vanish on every
# redeploy/restart.
UPLOADS_DIR=

SEED_ADMIN_EMAIL=admin@bocofac.coop
SEED_ADMIN_PASSWORD=Admin123!
SEED_BOARD_EMAIL=board@bocofac.coop
SEED_BOARD_PASSWORD=Board123!

# Preferred: Brevo's transactional email HTTP API (plain HTTPS - works from
# cloud hosts that block outbound SMTP ports entirely). Get a key from
# Brevo > Settings > SMTP & API > API Keys. SMTP_FROM must be a sender address
# verified in that Brevo account.
BREVO_API_KEY=
SMTP_FROM=

# Fallback: raw SMTP, used only when BREVO_API_KEY isn't set. Works for local
# dev but many cloud hosts block outbound SMTP - use a Gmail App Password, not
# your normal login password (Google Account > Security > 2-Step Verification > App Passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
