# Copy this file to .env (same folder) and fill in the blanks from
# Firebase Console > Project settings > General > Your apps > SDK setup and configuration.
# Restart `npm run dev` after editing - CRA only reads .env at startup.
# Firebase Hosting serves the static build, so these are baked in at `npm run build` time -
# make sure frontend/.env is filled in before building for deploy.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=bocofac-ad6b4.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://bocofac-ad6b4-default-rtdb.asia-southeast1.firebasedatabase.app
REACT_APP_FIREBASE_PROJECT_ID=bocofac-ad6b4
REACT_APP_FIREBASE_STORAGE_BUCKET=bocofac-ad6b4.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
